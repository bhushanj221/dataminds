# Copy this file to .env and fill in the values:   cp .env.example .env
# Never commit the real .env.

# ── PostgreSQL (app database) ─────────────────────────────────
POSTGRES_DB=datamind
POSTGRES_USER=datamind
POSTGRES_PASSWORD=change-me

# ── Auth ──────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Credential vault (REQUIRED) ───────────────────────────────
# Encrypts saved data-source passwords. Must be a Fernet key (32 url-safe base64 bytes).
# Generate one with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it stable: changing it later makes already-saved source passwords unreadable.
ENCRYPTION_KEY=

# ── AI / LLM (optional) ───────────────────────────────────────
# Leave LLM_API_KEY blank to run without AI features.
LLM_PROVIDER=anthropic
#   ^ anthropic | openai | ollama
LLM_API_KEY=
LLM_MODEL=
#   ^ blank = provider default
LLM_BASE_URL=
#   ^ only for ollama / OpenAI-compatible endpoints, e.g. http://localhost:11434
LLM_PLATFORM_DAILY_LIMIT=50
#   ^ max AI questions per user per day on the platform key
