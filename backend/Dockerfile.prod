# Production backend image: no --reload, code baked in (not volume-mounted).
# IMPORTANT: single process only. The alerts/reports poller runs in-process,
# so running multiple workers/replicas would double-fire alerts and reports.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code (baked in — no volume mount in prod)
COPY . .

EXPOSE 8000

# Single uvicorn process (no --reload, no --workers) — see note above.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
